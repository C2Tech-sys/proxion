# Server
PORT=3080
HOST=0.0.0.0
NODE_ENV=development

# Proxmox VE connection (PVE_URL is required, e.g. https://pve.example.com:8006)
PVE_URL=
PVE_TLS_INSECURE=false
PVE_TLS_FINGERPRINT=

# Service token ("token mode") -- optional, but set both or neither.
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=

# Session -- required in production; auto-generated (with a warning) in development.
SESSION_SECRET=

# Off by default. When true (and a service token is configured above),
# unauthenticated requests are treated as the service token's identity --
# a single shared identity, intended for homelabs/dev only.
PROXION_ALLOW_TOKEN_MODE=false

# Whether the proxion.sid cookie gets Secure. Defaults to NODE_ENV=production.
# Set to false if serving production over plain HTTP (e.g. a private mesh
# with no TLS-terminating reverse proxy) -- otherwise the browser silently
# drops the cookie and login appears to do nothing. Leave unset otherwise.
PROXION_COOKIE_SECURE=

# Overrides where the built web app (apps/web/dist) is served from in
# production. Leave unset for local/bare-metal use; the Docker image sets
# this itself.
PROXION_WEB_DIST=

# Console thumbnails via a host agent (optional; see agent/README.md). Without these,
# thumbnails are captured over VNC, which logs a vncproxy task in PVE per capture.
# PROXION_AGENTS=pve1=http://100.64.0.10:9420,pve2=http://100.64.0.11:9420
# PROXION_AGENT_TOKEN=CHANGEME

# Where per-user data (currently: preferences) is persisted -- one JSON file per user under
# <dir>/prefs/. Relative to the process cwd for local/bare-metal use; the Docker image sets
# this to /app/data. Created on startup.
PROXION_DATA_DIR=./data
