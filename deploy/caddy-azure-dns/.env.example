# Compose-level settings. Copy to .env and fill in real values:
#   cp .env.example .env
#
# BIND_ADDR: the host's mesh IP (Tailscale/WireGuard/etc) that Caddy's
# 80/443 get published on. NEVER 0.0.0.0 -- that would expose the host to
# the public internet, defeating the point of the mesh-only setup.
BIND_ADDR=100.64.0.2

# PROXION_HOST: the public hostname Caddy requests a certificate for and
# serves Proxion on. Its A record can point at BIND_ADDR (a private/CGNAT
# address) -- Let's Encrypt's DNS-01 challenge never has to reach it.
PROXION_HOST=proxion.example.com

# PROXION_IMAGE: which Proxion image to run. Pin a version; to upgrade, bump
# the tag and run `./deploy.sh update`. (Comment out and uncomment `build:`
# in docker-compose.yml to build from this checkout instead.)
PROXION_IMAGE=ghcr.io/c2tech-sys/proxion:0.1.0
