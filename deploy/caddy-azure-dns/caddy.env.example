# Caddy environment. Copy to caddy.env and fill in real values:
#   cp caddy.env.example caddy.env
#
# See README.md in this directory for how to create the Azure app
# registration and role assignment these values come from.

# Public hostname Caddy requests a certificate for and serves Proxion on.
PROXION_HOST=proxion.example.com

# Optional: contact address Let's Encrypt may use for certificate
# problem notices. Leave empty to omit.
ACME_EMAIL=

# Azure app registration (service principal) with "DNS Zone Contributor"
# scoped to the DNS zone that holds PROXION_HOST, used for the ACME DNS-01
# challenge against Azure DNS.
AZURE_TENANT_ID=CHANGEME
AZURE_CLIENT_ID=CHANGEME
AZURE_CLIENT_SECRET=CHANGEME
AZURE_SUBSCRIPTION_ID=CHANGEME
AZURE_RESOURCE_GROUP=CHANGEME
