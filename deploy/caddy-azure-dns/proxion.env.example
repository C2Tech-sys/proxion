# Proxion server environment. Copy to proxion.env and fill in real values:
#   cp proxion.env.example proxion.env
#
# Full reference: ../../docs/deploy.md and ../../apps/server/README.md.

NODE_ENV=production
PORT=3080
HOST=0.0.0.0

# Where the Docker image put the built web app -- do not change unless you
# also change the image layout.
PROXION_WEB_DIST=/app/web/dist

# Proxmox VE connection. No trailing slash, no /api2/json.
PVE_URL=https://pve.example.local:8006

# TLS to PVE: prefer pinning the certificate's fingerprint (PVE's default
# cert is self-signed) over disabling verification. Get it on a PVE node
# with `pvenode cert info` (see this kit's README).
PVE_TLS_FINGERPRINT=
# PVE_TLS_INSECURE=true   # last resort; skips all verification

# Optional read-only service token, used for the live poller/SSE feed and
# (if PROXION_ALLOW_TOKEN_MODE=true) as a fallback identity. Must be set
# together, or not at all. See docs/deploy.md for the recommended
# PVEAuditor-style role and exact `pveum` commands.
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=

# Required in production: signs the session cookie. Generate with
# `openssl rand -hex 32`.
SESSION_SECRET=CHANGEME

# Off by default -- see docs/deploy.md before enabling.
PROXION_ALLOW_TOKEN_MODE=false

# Caddy terminates TLS in front of Proxion, so the session cookie should
# get the Secure flag.
PROXION_COOKIE_SECURE=true

# Optional per-node host agent, for console thumbnails without a `vncproxy`
# task per capture. Uncomment and set both together -- see agent/README.md
# for setting up the agent itself, and "Console thumbnails" / "Host agent"
# in apps/server/README.md for the capture strategy and fallback behaviour.
# PROXION_AGENTS=pve1=http://100.64.0.10:9420,pve2=http://100.64.0.11:9420
# PROXION_AGENT_TOKEN=CHANGEME

# Largest storage-upload request body this server will accept and stream through to PVE, in
# bytes. Caddy allows large request bodies by default, so no reverse-proxy config change is
# needed here. Defaults to 32 GiB (34359738368) if unset.
# PROXION_UPLOAD_MAX_BYTES=34359738368

# Alert notifications (webhook and/or email) -- off by default. See the README's
# "Notifications" section for the full reference and examples (Discord, ntfy, SMTP). The token
# and any SMTP credentials embedded in the URL are never logged.
# PROXION_NOTIFY_WEBHOOK_URL=
# PROXION_NOTIFY_WEBHOOK_FORMAT=generic   # generic | discord | slack | ntfy | gotify
# PROXION_NOTIFY_WEBHOOK_TOKEN=
# PROXION_NOTIFY_SMTP_URL=
# PROXION_NOTIFY_EMAIL_FROM=
# PROXION_NOTIFY_EMAIL_TO=
# PROXION_NOTIFY_MIN_SEVERITY=warning     # warning | error
# PROXION_NOTIFY_INCLUDE_RESOLVED=true
# PROXION_NOTIFY_DEBOUNCE_MS=10000
# PROXION_NOTIFY_SITE_NAME=Proxion
# Optional allowlist for where notifications may be sent (webhook and SMTP host names, comma-
# separated; *.example.com matches one extra label). Unset = any host. See the README.
# PROXION_NOTIFY_ALLOWED_HOSTS=
# Lets notification messages link back into this deployment.
# PROXION_PUBLIC_URL=https://proxion.example.com
